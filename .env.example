# Server-side Cloudflare Workers AI settings. Never prefix secrets with VITE_.
AI_PROVIDER=cloudflare-workers-ai
CLOUDFLARE_ACCOUNT_ID=replace-with-account-id
CLOUDFLARE_AI_API_TOKEN=replace-with-dedicated-token
AI_API_BASE_URL=https://api.cloudflare.com/client/v4/accounts/replace-with-account-id/ai/v1
AI_GENERATION_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
AI_EMBEDDING_MODEL=@cf/qwen/qwen3-embedding-0.6b
AI_EMBEDDING_DIMENSIONS=1024
AI_MAX_OUTPUT_TOKENS=700
AI_REPORT_MAX_OUTPUT_TOKENS=2200
AI_REQUESTS_PER_MINUTE=8
AI_REQUESTS_PER_DAY=150
EXTERNAL_REQUESTS_PER_MINUTE=20
EXTERNAL_REQUESTS_PER_DAY=500
AI_DEMO_MODE=false
AI_SERVER_PORT=8787

# Public-deployment protection. NODE_ENV=production enables this gate and
# requires all four values. TURNSTILE_SITE_KEY is public; the other secrets
# must be stored only in the host's server-side environment settings.
TURNSTILE_SITE_KEY=replace-with-public-site-key
TURNSTILE_SECRET_KEY=replace-with-secret-key
TURNSTILE_ALLOWED_HOSTNAMES=your-service.onrender.com
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_MINUTES=240

# Enable only behind a trusted reverse proxy such as Render. The app then uses
# its X-Forwarded-For address for per-visitor rate limiting.
TRUST_PROXY=false

# Optional development sources.
HACKER_NEWS_API_URL=https://hacker-news.firebaseio.com/v0
NEWS_REFRESH_MINUTES=60
